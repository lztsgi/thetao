# Wi-Fi Calling / VoWiFi / ePDG
# mihomo rule-provider: behavior=classical, format=text

# =========================
# US - Red Pocket GSMA / AT&T
# =========================

# AT&T 核心域名
DOMAIN-SUFFIX,atl.net
DOMAIN-SUFFIX,att.net
DOMAIN-SUFFIX,att.com
DOMAIN-SUFFIX,mobilecsf.att.com

# AT&T IMS
DOMAIN-SUFFIX,ims.mnc410.mcc310.3gppnetwork.org
DOMAIN-SUFFIX,mnc410.mcc310.pub.3gppnetwork.org

# AT&T ePDG 固定地址
IP-CIDR,12.90.152.0/24,no-resolve
IP-CIDR,12.91.152.0/24,no-resolve
IP-CIDR,107.122.31.0/32,no-resolve


# =========================
# US - Ultra Mobile / T-Mobile
# =========================

# Ultra Mobile 当前卡使用 310-240
# 匹配：
# epdg.epc.mnc240.mcc310.pub.3gppnetwork.org
# ss.epdg.epc.mnc240.mcc310.pub.3gppnetwork.org
# epdg.epc.geo.mnc240.mcc310.pub.3gppnetwork.org
DOMAIN-SUFFIX,mnc240.mcc310.pub.3gppnetwork.org

# T-Mobile 主网常用 310-260
# 匹配普通、ss 和 geo ePDG 域名
DOMAIN-SUFFIX,mnc260.mcc310.pub.3gppnetwork.org

# IMS Realm：无 pub 的域名也一并覆盖
DOMAIN-SUFFIX,ims.mnc240.mcc310.3gppnetwork.org
DOMAIN-SUFFIX,ims.mnc260.mcc310.3gppnetwork.org

# T-Mobile Wi-Fi Calling 相关服务
DOMAIN-SUFFIX,crl.t-mobile.com

# 你本次抓包观察到的 Ultra/T-Mobile ePDG IP
# 仅作临时兜底，域名规则才是主要规则
IP-CIDR,208.54.32.35/32,no-resolve
